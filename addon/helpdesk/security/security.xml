<odoo>
    <record id="res_groups_privilege_helpdesk" model="res.groups.privilege">
        <field name="name">Hỗ trợ khách hàng</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="base.module_category_services_helpdesk"/>
    </record>

    <record id="group_helpdesk_agent" model="res.groups">
        <field name="name">Nhân viên hỗ trợ</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="helpdesk.res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_helpdesk_supervisor" model="res.groups">
        <field name="name">Giám sát viên hỗ trợ</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="helpdesk.res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_agent'))]"/>
    </record>
    <record id="group_helpdesk_admin" model="res.groups">
        <field name="name">Quản trị viên hỗ trợ</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="helpdesk.res_groups_privilege_helpdesk"/>
        <field name="implied_ids" eval="[(4, ref('helpdesk.group_helpdesk_supervisor'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
</odoo>
