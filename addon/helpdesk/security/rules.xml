<odoo>
    <record id="rule_helpdesk_ticket_company" model="ir.rule">
        <field name="name">Phiếu hỗ trợ: công ty được phép</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_helpdesk_ticket_agent" model="ir.rule">
        <field name="name">Phiếu hỗ trợ: nhân viên xem phiếu chưa gán hoặc được giao</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('user_id', 'in', [user.id, False])]</field>
        <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_agent'))]"/>
    </record>

    <record id="rule_helpdesk_ticket_supervisor" model="ir.rule">
        <field name="name">Phiếu hỗ trợ: giám sát viên xem toàn bộ trong công ty được phép</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="domain_force">[('id', '!=', 0)]</field>
        <field name="groups" eval="[(4, ref('helpdesk.group_helpdesk_supervisor'))]"/>
    </record>
</odoo>
