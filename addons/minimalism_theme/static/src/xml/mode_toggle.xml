<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="minimalism_theme.ModeToggle">
        <div class="o_min_mode_toggle d-flex">
            <button type="button" class="o_nav_entry"
                    t-att-title="label" t-att-aria-label="label" t-on-click="toggle"
                    t-att-disabled="status.loading" t-att-aria-busy="status.loading ? 'true' : 'false'">
                <i class="fa fa-lg" t-att-class="status.loading ? 'fa-spinner fa-spin' : (isDark ? 'fa-sun-o' : 'fa-moon-o')" aria-hidden="true"/>
            </button>
        </div>
    </t>
</templates>
