<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.minimalism</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Minimalism" name="minimalism_theme" groups="base.group_system"
                     logo="/minimalism_theme/static/description/icon.png">
                    <block title="Appearance for all users" name="min_appearance">
                        <setting id="min_accent_preset_setting" string="Accent color" help="Choose one of seven presets for primary buttons, selected controls and active tabs. Save and reload Odoo to apply it for all users. Only Settings administrators can change this selection.">
                            <field name="min_accent_preset" widget="radio" class="o_min_accent_presets"/>
                            <div class="text-muted mt-3">
                                Each preset includes matching highlights and readable button labels. Backgrounds, text, and success, warning and error colors retain their theme defaults.
                            </div>
                        </setting>
                    </block>
                    <block title="Personal appearance" name="min_personal_appearance">
                        <div class="px-4 pb-3 text-muted">
                            Each user switches day or night mode with the sun/moon button in the top bar. The accent preset works in both modes.
                        </div>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
    <record id="action_min_theme_settings" model="ir.actions.act_window">
        <field name="name">Minimalism Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'minimalism_theme', 'bin_size': False}</field>
    </record>
    <menuitem id="menu_min_theme_settings" name="Minimalism" parent="base.menu_administration"
              action="action_min_theme_settings" groups="base.group_system" sequence="20"/>
</odoo>
