<odoo>
    <record id="view_helpdesk_ticket_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.list</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <list string="ticket hỗ trợ" default_order="create_date desc" decoration-danger="is_overdue">
                <header>
                    <button name="action_open_assign_wizard" type="object" string="Gán nhân viên xử lý"
                            display="always" class="btn-primary"
                            groups="helpdesk.group_helpdesk_agent"/>
                </header>
                <field name="ticket_ref"/>
                <field name="name"/>
                <field name="partner_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="stage_id"/>
                <field name="priority" widget="priority"/>
                <field name="channel" optional="hide"/>
                <field name="date_deadline" optional="show"/>
                <field name="is_overdue" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_helpdesk_ticket_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <form string="ticket hỗ trợ">
                <header>
                    <button name="action_open_assign_wizard" type="object" string="Gán nhân viên xử lý"
                            class="btn-secondary" groups="helpdesk.group_helpdesk_agent"/>
                    <button name="action_close_ticket" type="object" string="Đóng ticket"
                            class="btn-primary" invisible="stage_is_closed"/>
                    <field name="stage_id" widget="statusbar" options="{'clickable': True}"/>
                </header>
                <sheet>
                    <field name="stage_is_closed" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Nhập tiêu đề yêu cầu của khách hàng"/></h1>
                        <div><field name="ticket_ref" readonly="1"/></div>
                    </div>
                    <group>
                        <group string="Khách hàng">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                            <field name="channel"/>
                        </group>
                        <group string="Phân công xử lý">
                            <field name="user_id"/>
                            <field name="priority" widget="priority"/>
                            <field name="date_deadline"/>
                            <field name="is_overdue" readonly="1"/>
                            <field name="closed_date"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mô tả" name="description">
                            <field name="description" placeholder="Mô tả sự cố hoặc yêu cầu cần hỗ trợ"/>
                        </page>
                        <page string="Kết quả xử lý" name="resolution">
                            <field name="resolution_notes" placeholder="Ghi lại cách xử lý ticket"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_helpdesk_ticket_search" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search string="Tìm ticket hỗ trợ">
                <field name="ticket_ref"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="stage_id"/>
                <filter name="my_tickets" string="ticket của tôi" domain="[('user_id', '=', uid)]"/>
                <filter name="open_tickets" string="Chưa đóng" domain="[('stage_id.is_closed', '=', False)]"/>
                <separator/>
                <filter name="group_stage" string="Nhóm theo trạng thái" domain="[]" context="{'group_by': 'stage_id'}"/>
                <filter name="group_agent" string="Nhóm theo nhân viên xử lý" domain="[]" context="{'group_by': 'user_id'}"/>
                <filter name="group_channel" string="Nhóm theo kênh tiếp nhận" domain="[]" context="{'group_by': 'channel'}"/>
            </search>
        </field>
    </record>
</odoo>
