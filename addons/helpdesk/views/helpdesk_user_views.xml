<odoo>
    <record id="action_helpdesk_create_agent" model="ir.actions.act_window">
        <field name="name">Tạo nhân viên hỗ trợ</field>
        <field name="res_model">helpdesk.agent.create.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <record id="view_helpdesk_agent_list" model="ir.ui.view">
        <field name="name">helpdesk.agent.list</field>
        <field name="model">res.users</field>
        <field name="arch" type="xml">
            <list string="Nhân viên hỗ trợ" create="0" delete="0">
                <header>
                    <button name="%(action_helpdesk_create_agent)d" type="action"
                            string="Tạo nhân viên" class="btn-primary"
                            groups="helpdesk.group_helpdesk_supervisor" display="always"/>
                </header>
                <field name="name"/>
                <field name="login"/>
                <field name="helpdesk_agent"/>
                <field name="share" column_invisible="True"/>
            </list>
        </field>
    </record>
</odoo>
