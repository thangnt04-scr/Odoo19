<odoo>
    <record id="action_helpdesk_tickets" model="ir.actions.act_window">
        <field name="name">ticket hỗ trợ</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_helpdesk_ticket_search"/>
    </record>
    <record id="action_helpdesk_stages" model="ir.actions.act_window">
        <field name="name">Trạng thái</field>
        <field name="res_model">helpdesk.stage</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_helpdesk_customers" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('helpdesk_customer', '=', True)]</field>
        <field name="context">{'default_helpdesk_customer': True}</field>
        <field name="view_id" ref="view_helpdesk_customer_list"/>
    </record>
    <record id="action_helpdesk_agents" model="ir.actions.act_window">
        <field name="name">Nhân viên hỗ trợ</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('helpdesk_agent', '=', True), ('share', '=', False)]</field>
        <field name="view_id" ref="view_helpdesk_agent_list"/>
    </record>

    <menuitem id="menu_helpdesk_root" name="Hỗ trợ khách hàng" sequence="45"
              groups="helpdesk.group_helpdesk_agent"/>
    <menuitem id="menu_helpdesk_tickets" name="Ticket hỗ trợ"
              parent="menu_helpdesk_root" action="action_helpdesk_tickets" sequence="10"/>
    <menuitem id="menu_helpdesk_customers" name="Khách hàng"
              parent="menu_helpdesk_root" action="action_helpdesk_customers" sequence="20"/>
    <menuitem id="menu_helpdesk_agents" name="Nhân viên hỗ trợ"
              parent="menu_helpdesk_root" action="action_helpdesk_agents" sequence="30"
              groups="helpdesk.group_helpdesk_supervisor"/>
    <menuitem id="menu_helpdesk_configuration" name="Cấu hình"
              parent="menu_helpdesk_root" sequence="90"
              groups="helpdesk.group_helpdesk_supervisor"/>
    <menuitem id="menu_helpdesk_stages" name="Trạng thái"
              parent="menu_helpdesk_configuration" action="action_helpdesk_stages" sequence="10"/>
</odoo>
