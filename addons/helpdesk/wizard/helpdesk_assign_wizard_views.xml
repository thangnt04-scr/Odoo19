<odoo>
    <record id="view_helpdesk_assign_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.assign.wizard.form</field>
        <field name="model">helpdesk.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Phân công ticket hỗ trợ">
                <group>
                    <field name="user_id"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Gán ticket" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
