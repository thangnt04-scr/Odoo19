<odoo>
    <record id="view_helpdesk_agent_create_wizard_form" model="ir.ui.view">
        <field name="name">helpdesk.agent.create.wizard.form</field>
        <field name="model">helpdesk.agent.create.wizard</field>
        <field name="arch" type="xml">
            <form string="Tạo nhân viên hỗ trợ">
                <group>
                    <field name="name"/>
                    <field name="login"/>
                    <field name="email"/>
                    <field name="password" password="True"/>
                </group>
                <footer>
                    <button name="action_create_agent" type="object" string="Tạo nhân viên" class="btn-primary"/>
                    <button string="Hủy" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
