<odoo noupdate="1">
    <record id="stage_new" model="helpdesk.stage">
        <field name="name">Mới</field>
        <field name="sequence">10</field>
    </record>
    <record id="stage_in_progress" model="helpdesk.stage">
        <field name="name">Đang xử lý</field>
        <field name="sequence">20</field>
    </record>
    <record id="stage_waiting_customer" model="helpdesk.stage">
        <field name="name">Chờ khách hàng</field>
        <field name="sequence">30</field>
    </record>
    <record id="stage_closed" model="helpdesk.stage">
        <field name="name">Đã đóng</field>
        <field name="sequence">40</field>
        <field name="is_closed" eval="True"/>
    </record>
</odoo>
